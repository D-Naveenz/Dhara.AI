<Project>
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)LICENSE.txt"
          Pack="true"
          PackagePath=""
          Visible="false" />
    <None Include="$(MSBuildProjectDirectory)\README.md"
          Pack="true"
          PackagePath=""
          Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)assets\branding\dhara-logo-colored_sm.png"
          Pack="true"
          PackagePath=""
          Visible="false" />
  </ItemGroup>
</Project>
